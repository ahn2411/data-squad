# ─────────────────────────────────────────────────────────────
# Data Science Squad Hub — environment variables
# Copy to .env.local and fill in from Supabase Dashboard → Settings → API
# ─────────────────────────────────────────────────────────────

# Public (safe for the browser). Used by @supabase/ssr clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in Server
# Components / Server Actions / route handlers for privileged Auth operations.
# Never expose this value to browser code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required by the protected reminder endpoint. Set the same random secret in
# Vercel Production Environment Variables and GitHub repository Actions secrets
# (Settings → Secrets and variables → Actions). GitHub Actions calls the
# endpoint; Vercel no longer schedules this job.
CRON_SECRET=replace-with-a-long-random-secret

# The canonical app origin used for auth email redirects.
# Local dev: http://localhost:3000. Set production to the HTTPS Vercel domain.
# If omitted in production on Vercel, the app falls back to
# VERCEL_PROJECT_PRODUCTION_URL and never generates localhost email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
