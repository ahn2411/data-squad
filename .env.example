# ─────────────────────────────────────────────────────────────
# Data Science Squad Hub — environment variables
# Copy to .env.local and fill in from Supabase Dashboard → Settings → API
# ─────────────────────────────────────────────────────────────

# Public (safe for the browser). Used by @supabase/ssr clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only in Server
# Components / Server Actions / route handlers for privileged operations
# (e.g. bootstrapping the first admin). RLS still applies.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The base URL of the deployed app. Used for auth email redirects.
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
